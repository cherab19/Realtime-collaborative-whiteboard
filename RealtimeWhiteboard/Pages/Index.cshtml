@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Real-Time Whiteboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealtimeWhiteboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts for UI -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="whiteboard-body">

    <!-- Top Left: Session Info -->
    <div class="floating-panel panel-top-left">
        <h1 class="logo-text">CollabBoard</h1>
        <div class="d-flex gap-2 align-items-center mt-2">
            <div id="connection-status" class="status-offline">Connecting...</div>
            <select id="session-select" class="form-select form-select-sm shadow-none" style="width: 150px;">
                <option value="">Select Session</option>
            </select>
            <button id="btn-new-session" class="btn btn-primary btn-sm px-3 shadow-sm">+</button>
        </div>
    </div>

    <!-- Top Center: Toolbar -->
    <div class="floating-panel panel-top-center">
        <div class="toolbar-tools">
            <button class="btn-tool active" data-tool="select" title="Select">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 7.07 16.97 2.51-7.39 7.39-2.51L3 3z"></path><path d="m13 13 6 6"></path></svg>
            </button>
            <button class="btn-tool" data-tool="pen" title="Pen">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg>
            </button>
            <button class="btn-tool" data-tool="line" title="Line">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="19" x2="19" y2="5"></line></svg>
            </button>
            <button class="btn-tool" data-tool="rect" title="Rectangle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
            </button>
            <button class="btn-tool" data-tool="text" title="Text">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
            </button>
            <button class="btn-tool" data-tool="eraser" title="Eraser">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"></path><path d="M22 21H7"></path><path d="m5 11 9 9"></path></svg>
            </button>
        </div>
    </div>

    <!-- Top Right: Properties -->
    <div class="floating-panel panel-top-right">
        <div class="properties-tools">
            <div class="prop-group">
                <label>Color</label>
                <input type="color" id="color-picker" value="#1e1e1e" class="color-swatch">
            </div>
            <div class="prop-group">
                <label>Size</label>
                <div class="d-flex align-items-center gap-2">
                    <input type="range" id="brush-size" min="1" max="20" value="3" class="form-range" style="width: 80px;">
                    <span id="brush-size-val" class="small fw-bold">3</span>
                </div>
            </div>
            <button id="btn-clear" class="btn btn-light btn-sm text-danger ms-2 border" title="Clear Canvas">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
            </button>
        </div>
    </div>

    <div id="whiteboard-container">
        <!-- Text Input Overlay -->
        <div id="text-input-container" style="display: none; position: absolute; z-index: 100;">
            <input type="text" id="canvas-text-input" class="canvas-text-input" placeholder="Type here..." autocomplete="off">
        </div>
        <canvas id="whiteboard"></canvas>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/whiteboard.js" asp-append-version="true"></script>
    <script src="~/js/whiteboard-signalr.js" asp-append-version="true"></script>
</body>
</html>
